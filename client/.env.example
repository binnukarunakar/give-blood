# Client build-time env (names only — never commit values).
# Every VITE_* value is baked into the public bundle: put nothing secret here.
# Canonical list: docs/ARCHITECTURE.md § "Env-var surface".

# Firebase web config (public-by-design; restrict by auth domain + API key referrer)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Web-push (FCM) VAPID public key
VITE_FCM_VAPID_PUBLIC_KEY=

# Maps JS SDK browser key — HTTP-referrer-restricted
VITE_MAPS_BROWSER_KEY=

# API origin. Leave empty when the server serves this bundle (same origin).
VITE_API_BASE_URL=

# Local demo only. Set to 1 to build the click-through demo (src/demo): fake
# persona logins, no Firebase, and an in-app push inbox. Leave EMPTY for every
# real build — a value of 1 replaces the auth path.
VITE_DEMO_MODE=
